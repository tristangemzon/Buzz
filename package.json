{
  "name": "buzz",
  "productName": "Buzz",
  "version": "0.1.0",
  "description": "Buzz — secure, AIM/AOL-flavoured P2P chat client (Electron + libp2p + SQLCipher).",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "pack:win": "npm run build && electron-builder --win --x64",
    "pack:mac": "npm run build && electron-builder --mac --arm64",
    "pack:linux": "npm run build && electron-builder --linux --x64",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "postinstall": "electron-rebuild --module-dir node_modules/better-sqlite3-multiple-ciphers"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^15.1.0",
    "@chainsafe/libp2p-yamux": "^6.0.2",
    "@libp2p/bootstrap": "^10.1.0",
    "@libp2p/circuit-relay-v2": "^1.1.0",
    "@libp2p/crypto": "^4.1.0",
    "@libp2p/identify": "^2.1.0",
    "@libp2p/interface": "^1.6.0",
    "@libp2p/kad-dht": "^12.1.0",
    "@libp2p/mdns": "^10.1.5",
    "@libp2p/peer-id": "^4.2.0",
    "@libp2p/peer-id-factory": "^4.2.0",
    "@libp2p/tcp": "^9.1.0",
    "@libp2p/websockets": "^8.1.0",
    "@noble/hashes": "^1.4.0",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "argon2": "^0.40.3",
    "better-sqlite3-multiple-ciphers": "^11.3.0",
    "cbor-x": "^1.6.0",
    "it-pipe": "^3.0.1",
    "it-stream-types": "^2.0.1",
    "keytar": "^7.9.0",
    "libp2p": "^1.5.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "multiformats": "^13.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uint8arrays": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.2.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.13",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.buzz.app",
    "productName": "Buzz",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3-multiple-ciphers/**",
      "**/node_modules/argon2/**",
      "**/node_modules/keytar/**",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Buzz"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Network"
    }
  }
}
