{
  "name": "buzz",
  "productName": "Buzz",
  "version": "0.9.6",
  "description": "Buzz — secure, AIM/AOL-flavoured P2P chat client (Electron + libp2p + SQLCipher).",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "author": {
    "name": "Tristan Gemzon",
    "email": "tristangemzon@outlook.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:mesh": "cd buzz-mesh && make all",
    "build:all": "npm run build:mesh && electron-vite build",
    "start": "electron-vite preview",
    "pack:win": "npm run build && electron-builder --win --x64 --publish always",
    "pack:mac": "npm run build && electron-builder --mac --arm64 --publish always",
    "pack:linux": "npm run build && electron-builder --linux --x64 --publish always",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "postinstall": "electron-rebuild --module-dir node_modules/better-sqlite3-multiple-ciphers"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/bootstrap": "^12.0.24",
    "@libp2p/circuit-relay-v2": "^4.2.6",
    "@libp2p/crypto": "^5.1.19",
    "@libp2p/identify": "^4.1.7",
    "@libp2p/interface": "^3.2.3",
    "@libp2p/mdns": "^12.0.24",
    "@libp2p/peer-id": "^6.0.10",
    "@libp2p/peer-id-factory": "^4.2.0",
    "@libp2p/tcp": "^11.0.21",
    "@libp2p/websockets": "^10.1.14",
    "@noble/hashes": "^1.4.0",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/ws": "^8.18.1",
    "argon2": "^0.44.0",
    "better-sqlite3-multiple-ciphers": "^12.10.0",
    "cbor-x": "^1.6.0",
    "electron-updater": "^6.8.3",
    "it-pipe": "^3.0.1",
    "it-stream-types": "^2.0.1",
    "jsqr": "^1.4.0",
    "keytar": "^7.9.0",
    "libp2p": "^3.3.3",
    "libsodium-wrappers-sumo": "^0.8.4",
    "multiformats": "^14.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uint8arrays": "^6.1.1",
    "ws": "^8.20.0",
    "zod": "^3.23.8",
    "zxcvbn-ts": "^2.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.4.5",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "com.buzz.app",
    "productName": "Buzz",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3-multiple-ciphers/**",
      "**/node_modules/argon2/**",
      "**/node_modules/keytar/**",
      "**/*.node",
      "**/buzz-mesh-*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "buzz-mesh/dist",
        "to": ".",
        "filter": [
          "buzz-mesh-*"
        ]
      }
    ],
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Buzz"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Network",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "tristangemzon",
      "repo": "Buzz",
      "releaseType": "release"
    }
  }
}
